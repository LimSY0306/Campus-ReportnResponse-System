@model IEnumerable<CampusReportSystem.Models.Feedback>

@{
    ViewData["Title"] = "Feedback Management";
    var currentStatus = ViewData["CurrentStatus"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Admin Feedback & Comments</h2>
        <p class="text-muted mb-0">View member submissions, comments, and send replies.</p>
    </div>
    <!-- Status Filter Navigation -->
    <div class="btn-group">
        <a asp-action="AdminIndex" class="btn btn-sm @(string.IsNullOrEmpty(currentStatus) || currentStatus == "All" ? "btn-primary" : "btn-outline-primary")">All</a>
        <a asp-action="AdminIndex" asp-route-statusFilter="Pending" class="btn btn-sm @(currentStatus == "Pending" ? "btn-warning text-dark" : "btn-outline-warning")">Pending</a>
        <a asp-action="AdminIndex" asp-route-statusFilter="Reviewed" class="btn btn-sm @(currentStatus == "Reviewed" ? "btn-success" : "btn-outline-success")">Reviewed</a>
        <a asp-action="AdminIndex" asp-route-statusFilter="Dismissed" class="btn btn-sm @(currentStatus == "Dismissed" ? "btn-secondary" : "btn-outline-secondary")">Dismissed</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border text-center py-5 shadow-sm rounded-3">
        <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
        <h5 class="fw-bold text-secondary">No Feedback Items</h5>
        <p class="text-muted mb-0">There are no feedback submissions for this filter.</p>
    </div>
}
else
{
    <div class="row g-4" id="feedback-container">
        @foreach (var item in Model)
        {
            <div class="col-12" id="feedback-card-@item.Id">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="fw-bold mb-1">@item.Subject</h5>
                                <div class="small text-muted">
                                    Submitted by <strong>@(item.User?.Name ?? "Sample Member")</strong> on @item.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                </div>
                            </div>
                            <div class="d-flex gap-2 align-items-center">
                                <span class="badge bg-secondary">@item.Type</span>
                                <span class="badge @(item.Status == "Reviewed" ? "bg-success" : item.Status == "Dismissed" ? "bg-secondary" : "bg-warning text-dark")" id="status-badge-@item.Id">
                                    @item.Status
                                </span>
                            </div>
                        </div>

                        <!-- RATING DISPLAY -->
                        @if (item.Rating > 0)
                        {
                            <div class="mb-2 text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= item.Rating)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star"></i>
                                    }
                                }
                            </div>
                        }

                        <!-- MEMBER MESSAGE -->
                        <div class="p-3 bg-light rounded-3 mb-3 text-dark">
                            @item.Message
                        </div>

                        <!-- ADMIN RESPONSE & ACTIONS -->
                        <div class="d-flex gap-2">
                            <input type="text" id="response-@item.Id" class="form-control" placeholder="Type admin reply/notes here..." value="@item.AdminResponse" />
                            <button type="button" class="btn btn-success text-nowrap fw-bold" onclick="updateStatus(@item.Id, 'Reviewed')">
                                <i class="bi bi-check-lg me-1"></i>Mark Reviewed
                            </button>
                            <button type="button" class="btn btn-outline-danger text-nowrap fw-bold" onclick="updateStatus(@item.Id, 'Dismissed')">
                                <i class="bi bi-x-circle me-1"></i>Dismiss
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        async function updateStatus(id, newStatus) {
            const responseInput = document.getElementById(`response-${id}`).value;
            const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');

            const formData = new FormData();
            formData.append('id', id);
            formData.append('status', newStatus);
            formData.append('response', responseInput);

            try {
                const res = await fetch('/Feedback/UpdateResponse', {
                    method: 'POST',
                    headers: { 
                        'RequestVerificationToken': tokenElement ? tokenElement.value : '' 
                    },
                    body: formData
                });

                const data = await res.json();
                if (data.success) {
                    if (newStatus === 'Dismissed') {
                        // Immediately animate and remove card from admin view
                        const card = document.getElementById(`feedback-card-${id}`);
                        if (card) {
                            card.style.transition = 'all 0.3s ease';
                            card.style.opacity = '0';
                            card.style.transform = 'scale(0.95)';
                            setTimeout(() => card.remove(), 300);
                        }
                    } else {
                        // Update status badge dynamically for Reviewed
                        const badge = document.getElementById(`status-badge-${id}`);
                        if (badge) {
                            badge.innerText = newStatus;
                            badge.className = 'badge bg-success';
                        }
                        alert('Feedback marked as Reviewed! It will now appear on Community Feedback.');
                    }
                } else {
                    alert(data.message || 'Failed to update feedback status.');
                }
            } catch (err) {
                alert('An error occurred while updating the feedback.');
            }
        }
    </script>
}