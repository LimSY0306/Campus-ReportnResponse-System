@model IEnumerable<CampusReportSystem.Models.Feedback>

@{
    ViewData["Title"] = "Community Feedback";
    var currentStatus = ViewData["CurrentStatus"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-chat-left-text-fill text-primary"></i> Community Feedback</h2>
        <p class="text-muted mb-0">Browse feedback, suggestions, and responses from our campus community.</p>
    </div>
    <a asp-action="Submit" class="btn btn-primary fw-bold shadow-sm">
        <i class="bi bi-plus-circle-fill me-1"></i> Submit Feedback
    </a>
</div>

<!-- FILTER BUTTONS -->
<div class="mb-4 d-flex gap-2">
    <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(currentStatus) ? "btn-dark" : "btn-outline-secondary")">
        All Public
    </a>
    <a asp-action="Index" asp-route-statusFilter="Reviewed" class="btn btn-sm @(currentStatus == "Reviewed" ? "btn-success" : "btn-outline-success")">
        Reviewed
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border text-center py-5 shadow-sm rounded-3">
        <i class="bi bi-chat-square-dots fs-1 text-muted d-block mb-2"></i>
        <h5 class="fw-bold text-secondary">No Feedback Found</h5>
        <p class="text-muted mb-0">There are currently no reviewed feedback posts to display.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="fw-bold mb-1">@item.Subject</h5>
                                <div class="small text-muted">
                                    Submitted by <strong>@(item.User?.Name ?? "Anonymous Member")</strong> 
                                    on @item.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-secondary">@item.Type</span>
                                <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>@item.Status</span>
                            </div>
                        </div>

                        <!-- RATING STARS -->
                        <div class="mb-3 text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= item.Rating)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star"></i>
                                }
                            }
                        </div>

                        <!-- FEEDBACK MESSAGE -->
                        <div class="p-3 bg-light rounded-3 mb-3 text-dark">
                            @item.Message
                        </div>

                        <!-- ADMIN RESPONSE / REPLY -->
                        @if (!string.IsNullOrWhiteSpace(item.AdminResponse))
                        {
                            <div class="p-3 bg-primary bg-opacity-10 border-start border-primary border-4 rounded-end-3 mb-3">
                                <div class="fw-bold text-primary mb-1">
                                    <i class="bi bi-reply-fill me-1"></i> Admin Response:
                                </div>
                                <div class="text-dark small">
                                    @item.AdminResponse
                                </div>
                            </div>
                        }

                        <!-- LIKE & DISLIKE REACTIONS -->
                        <div class="d-flex align-items-center gap-3 pt-2 border-top">
                            <button type="button" class="btn btn-sm btn-outline-success border-0 fw-bold" onclick="reactFeedback(@item.Id, 'like')">
                                <i class="bi bi-hand-thumbs-up-fill me-1"></i> 
                                <span id="likes-@item.Id">@item.LikesCount</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger border-0 fw-bold" onclick="reactFeedback(@item.Id, 'dislike')">
                                <i class="bi bi-hand-thumbs-down-fill me-1"></i> 
                                <span id="dislikes-@item.Id">@item.DislikesCount</span>
                            </button>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        async function reactFeedback(id, reactionType) {
            const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');

            const formData = new FormData();
            formData.append('id', id);
            formData.append('type', reactionType);

            try {
                const res = await fetch('/Feedback/React', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': tokenElement ? tokenElement.value : '' },
                    body: formData
                });

                const data = await res.json();
                if (data.success) {
                    document.getElementById(`likes-${id}`).innerText = data.likes;
                    document.getElementById(`dislikes-${id}`).innerText = data.dislikes;
                } else {
                    alert(data.message);
                }
            } catch (err) {
                alert('An error occurred while registering your reaction.');
            }
        }
    </script>
}