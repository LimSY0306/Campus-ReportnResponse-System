@model IEnumerable<CampusReportSystem.Models.Report>

@{
    ViewData["Title"] = "Campus Announcements";
    var searchString = ViewData["CurrentFilter"] as string;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="mb-0">📢 Campus Announcements</h2>
        
        <div class="d-flex align-items-center gap-2">
            <form asp-controller="Announcement" asp-action="Index" method="get" class="d-flex gap-2">
                <div class="input-group">
                    <input type="text" 
                           name="searchString" 
                           value="@searchString" 
                           class="form-control" 
                           placeholder="Search announcements..." />
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Search
                    </button>
                    @if (!string.IsNullOrEmpty(searchString))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Search">
                            <i class="bi bi-x-lg"></i> Clear
                        </a>
                    }
                </div>
            </form>

            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary text-nowrap">Back to Home</a>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center py-4 rounded-3 shadow-sm">
            <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
            @if (!string.IsNullOrEmpty(searchString))
            {
                <span>No announcements found matching "<strong>@searchString</strong>".</span>
            }
            else
            {
                <span>No announcements posted yet.</span>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var report in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm rounded-4 border-0">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-primary">@(report.Category?.Name ?? "Announcement")</span>
                                </div>
                                <h5 class="card-title fw-bold">
                                    @(report.Title ?? "Untitled Announcement")
                                </h5>
                                <p class="card-text text-secondary">
                                    @{
                                        var desc = report.Description ?? "";
                                        @(desc.Length > 100 ? desc.Substring(0, 100) + "..." : desc)
                                    }
                                </p>
                            </div>

                            <div class="pt-3 mt-2 border-top d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    <i class="bi bi-calendar-event me-1"></i>@report.CreatedAT.ToString("yyyy-MM-dd")
                                </small>

                                <button type="button" 
                                        class="btn btn-sm btn-outline-danger rounded-pill px-3" 
                                        id="like-btn-@report.Id" 
                                        onclick="toggleLike(this, @report.Id)">
                                    <i class="bi bi-heart-fill me-1"></i> Like 
                                    <span class="like-count badge bg-danger text-white ms-1" id="like-count-@report.Id">0</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    function toggleLike(btn, reportId) {
        let params = new URLSearchParams();
        params.append("id", reportId);

        fetch('/Report/ToggleLike', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: params
        })
        .then(response => {
            if (!response.ok) {
                throw new Error("HTTP error! Status: " + response.status);
            }
            return response.json();
        })
        .then(data => {
            console.log("Response:", data);

            if (data.success) {
                const countBadge = document.getElementById('like-count-' + reportId);
                if (countBadge) {
                    countBadge.innerText = data.likeCount;
                }

                if (data.isLiked) {
                    btn.classList.remove('btn-outline-danger');
                    btn.classList.add('btn-danger', 'text-white');
                } else {
                    btn.classList.remove('btn-danger', 'text-white');
                    btn.classList.add('btn-outline-danger');
                }
            } else if (data.requireLogin) {
                alert("Please log in first!");
                window.location.href = '/Account/Login';
            } else {
                alert("Failed: " + (data.message || "Unknown error"));
            }
        })
        .catch(error => {
            console.error('Fetch Error Detail:', error);
            alert("Error: " + error.message);
        });
    }
</script>