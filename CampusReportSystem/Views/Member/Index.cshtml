@model List<CampusReportSystem.Models.User>

@{
    ViewData["Title"] = "Member Maintenance";
    var currentFilter = ViewData["CurrentFilter"] as string ?? "";
    var statusFilter = ViewData["StatusFilter"] as string ?? "";
    var sortBy = ViewData["SortBy"] as string ?? "CreatedAt";
    var sortOrder = ViewData["SortOrder"] as string ?? "desc";
    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
}

<div id="alertContainer"></div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show text-center" role="alert" id="successAlert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <script>
        setTimeout(function() {
            var alert = document.getElementById('successAlert');
            if (alert) {
                alert.classList.remove('show');
                setTimeout(function() { alert.remove(); }, 300);
            }
        }, 3000);
    </script>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="custom-title">Member Maintenance</h2>
    <a asp-controller="Account" asp-action="Register" asp-route-role="User" class="submit-btn">+ Add New Member</a>
</div>

<!-- Search & Filter -->
<div class="row g-3 mb-3">
    <div class="col-md-5">
        <input type="text" id="searchInput" value="@currentFilter" class="form-control" placeholder="Search by name or email..." />
    </div>
    <div class="col-md-3">
        <select id="statusFilter" class="form-select">
            <option value="">-- All Statuses --</option>
            <option value="active" selected="@(statusFilter == "active")">Active</option>
            <option value="inactive" selected="@(statusFilter == "inactive")">Inactive</option>
        </select>
    </div>
    <div class="col-md-4 d-flex gap-2">
        <button type="button" id="searchBtn" class="btn btn-secondary">Search</button>
        <button type="button" id="resetBtn" class="btn btn-outline-secondary">Reset</button>
    </div>
</div>

<!-- Table -->
<table id="memberTable" class="table-custom">
    <thead>
        <tr>
            <th data-sort="FormattedId" class="sortable">ID <span class="sort-icon"></span></th>
            <th data-sort="Name" class="sortable">Name <span class="sort-icon"></span></th>
            <th data-sort="Email" class="sortable">Email <span class="sort-icon"></span></th>
            <th data-sort="IsActive" class="sortable">Status <span class="sort-icon"></span></th>
            <th data-sort="ReportsCount" class="sortable">Total Reports <span class="sort-icon"></span></th>
            <th data-sort="CreatedAt" class="sortable">Created At <span class="sort-icon"></span></th>
            <th class="text-center" style="width: 200px;">Actions</th>
        </tr>
    </thead>
    <tbody id="tableBody">
        @await Html.PartialAsync("_TableRows", Model, new ViewDataDictionary(ViewData) { { "IsAdmin", false } })
    </tbody>
</table>

<!-- Pagination Controls -->
<div class="d-flex justify-content-end mt-3">
    <nav>
        <ul class="pagination">
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <button class="page-link" id="prevPageBtn" @(currentPage <= 1 ? "disabled" : "")>Previous</button>
            </li>
            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <button class="page-link" id="nextPageBtn" @(currentPage >= totalPages ? "disabled" : "")>Next</button>
            </li>
        </ul>
    </nav>
</div>

<!-- Modal for Toggle Status -->
<div class="modal fade" id="toggleStatusModal" tabindex="-1" aria-labelledby="toggleStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered custom-delete-modal">
        <div class="modal-content text-dark">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="toggleStatusModalLabel">Confirm Status Change</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to <strong id="statusActionText"></strong> member account: <strong id="memberNameToToggle"></strong>?
            </div>
            <div class="modal-footer">
                <form asp-action="ToggleStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="memberIdToToggle" name="id" />
                    <button type="button" class="submit-btn btn-secondary-custom" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Confirm</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentSortBy = '@sortBy';
        let currentSortOrder = '@sortOrder';
        let currentPage = @currentPage;
        let totalPages = @totalPages;

        function reloadTable(page) {
            if (page === undefined) page = currentPage;
            const search = $('#searchInput').val();
            const status = $('#statusFilter').val();
            $.get('@Url.Action("Index")', {
                searchString: search,
                statusFilter: status,
                sortBy: currentSortBy,
                sortOrder: currentSortOrder,
                page: page,
                ajax: true
            })
                .done(function(html) {
                    $('#tableBody').html(html);
                    currentPage = page;
                    updatePagination();
                    updateSortIcons();
                    bindToggleModal();
                })
                .fail(function() {
                    alert('Failed to load data.');
                });
        }

        function updatePagination() {
            $('#prevPageBtn').prop('disabled', currentPage <= 1);
            $('#prevPageBtn').closest('li').toggleClass('disabled', currentPage <= 1);
            $('#nextPageBtn').prop('disabled', currentPage >= totalPages);
            $('#nextPageBtn').closest('li').toggleClass('disabled', currentPage >= totalPages);
        }

        function updateSortIcons() {
            $('.sortable').each(function() {
                const col = $(this).data('sort');
                const icon = $(this).find('.sort-icon');
                if (col === currentSortBy) {
                    icon.html(currentSortOrder === 'asc' ? ' &#9650;' : ' &#9660;');
                } else {
                    icon.html('');
                }
            });
        }

        $('.sortable').on('click', function() {
            const col = $(this).data('sort');
            if (col === currentSortBy) {
                currentSortOrder = (currentSortOrder === 'asc' ? 'desc' : 'asc');
            } else {
                currentSortBy = col;
                currentSortOrder = 'asc';
            }
            currentPage = 1;
            reloadTable(1);
        });

        $('#searchBtn').on('click', function() {
            currentPage = 1;
            reloadTable(1);
        });
        $('#resetBtn').on('click', function() {
            $('#searchInput').val('');
            $('#statusFilter').val('');
            currentSortBy = 'CreatedAt';
            currentSortOrder = 'desc';
            currentPage = 1;
            reloadTable(1);
        });
        $('#searchInput').on('keypress', function(e) {
            if (e.which === 13) {
                currentPage = 1;
                reloadTable(1);
            }
        });
        $('#statusFilter').on('change', function() {
            currentPage = 1;
            reloadTable(1);
        });

        $('#prevPageBtn').on('click', function() {
            if (currentPage > 1) {
                reloadTable(currentPage - 1);
            }
        });
        $('#nextPageBtn').on('click', function() {
            if (currentPage < totalPages) {
                reloadTable(currentPage + 1);
            }
        });

        function bindToggleModal() {
            const modal = document.getElementById('toggleStatusModal');
            if (modal) {
                const newModal = modal.cloneNode(true);
                modal.parentNode.replaceChild(newModal, modal);
                newModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-id');
                    const name = button.getAttribute('data-name');
                    const status = button.getAttribute('data-status');
                    document.getElementById('memberIdToToggle').value = id;
                    document.getElementById('memberNameToToggle').textContent = name;
                    document.getElementById('statusActionText').textContent = status;
                });
            }
        }
        bindToggleModal();
        updateSortIcons();

        const urlParams = new URLSearchParams(window.location.search);
        const status = urlParams.get('status');
        if (status) {
            window.history.replaceState({}, document.title, window.location.pathname);
            let message = '', alertClass = '';
            if (status === 'created') {
                message = 'Created successfully!';
                alertClass = 'custom-alert-created';
            } else if (status === 'updated') {
                message = 'Updated successfully!';
                alertClass = 'custom-alert-updated';
            } else if (status === 'deleted') {
                message = 'Deleted successfully!';
                alertClass = 'custom-alert-deleted';
            }
            if (message) {
                const alertDiv = document.createElement('div');
                alertDiv.className = `custom-alert ${alertClass} fade show`;
                alertDiv.role = 'alert';
                alertDiv.innerHTML = message;
                document.getElementById('alertContainer').appendChild(alertDiv);
                setTimeout(() => {
                    alertDiv.classList.remove('show');
                    setTimeout(() => alertDiv.remove(), 300);
                }, 2000);
            }
        }
        // ---- More Keyboard shortcuts ----
        $(document).on('keydown', function(e) {

            // Slash: focus search input
            if (e.key === '/') {
                e.preventDefault();
                $('#searchInput').focus();
                $('#searchInput').select();
            }
            // Escape: reset
            if (e.key === 'Escape') {
                $('#searchInput').val('');
                $('#statusFilter').val('');
                currentSortBy = 'CreatedAt';
                currentSortOrder = 'desc';
                currentPage = 1;
                reloadTable(1);
            }
        });
    </script>
}