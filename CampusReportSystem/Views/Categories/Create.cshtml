@model CampusReportSystem.Models.Category

@{
    ViewData["Title"] = "Create Category";
}

<div class="container mt-4">
    <h2>Create Category</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">
                        Category Name <span class="text-danger fw-bold">*</span>
                    </label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Parking, Utility, Security" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Briefly describe what kind of reports belong to this category..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="submit-btn">Create</button>
                    <a asp-action="Index" class="submit-btn btn-secondary-custom">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}