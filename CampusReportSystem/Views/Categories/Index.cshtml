@model IEnumerable<CampusReportSystem.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="container mt-2">
    <div id="alertContainer"></div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="custom-title">Category Management</h2>
        <a asp-action="Create" class="submit-btn">+ Create New Category</a>
    </div>

    <table class="table-custom">
        <thead>
            <tr>
                <th>ID</th>
                <th>Category Name</th>
                <th>Description</th>
                <th style="width: 30%;" class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@($"C{item.Id:D2}")</td>
                    <td>@item.Name</td>
                    <td class="text-muted">@(item.Description ?? "-")</td>
                    <td class="text-center">
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="detail-btn">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="edit-btn">Edit</a>
                            <button type="button"
                                    class="btn p-0 border-0 bg-transparent text-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteCategoryModal"
                                    data-id="@item.Id"
                                    data-name="@item.Name"
                                    title="Delete">
                                <i class="bi bi-trash3 fs-5"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="deleteCategoryModal" tabindex="-1" aria-labelledby="deleteCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered custom-delete-modal">
        <div class="modal-content text-dark">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteCategoryModalLabel">Confirm Delete Category</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete category: <strong id="categoryNameToDelete"></strong>?
            </div>
            <div class="modal-footer">
                <form asp-action="Delete" method="post">
                    <input type="hidden" id="categoryIdToDelete" name="id" />
                    <button type="button" class="submit-btn btn-secondary-custom" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="delete-btn">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteCategoryModal = document.getElementById('deleteCategoryModal');
        if (deleteCategoryModal) {
            deleteCategoryModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const categoryId = button.getAttribute('data-id');
                const categoryName = button.getAttribute('data-name');

                document.getElementById('categoryIdToDelete').value = categoryId;
                document.getElementById('categoryNameToDelete').textContent = categoryName;
            });
        }
        const urlParams = new URLSearchParams(window.location.search);
        const status = urlParams.get('status');
        if (status) {
            window.history.replaceState({}, document.title, window.location.pathname);
            let message = '';
            let alertClass = '';

            if (status === 'created') {
                message = 'Created successfully!';
                alertClass = 'custom-alert-created';
            } else if (status === 'updated') {
                message = 'Updated successfully!';
                alertClass = 'custom-alert-updated';
            } else if (status === 'deleted') {
                message = 'Deleted successfully!';
                alertClass = 'custom-alert-deleted';
            }

            if (message) {
                const alertDiv = document.createElement('div');
                alertDiv.className = `custom-alert ${alertClass} fade show`;
                alertDiv.role = 'alert';
                alertDiv.innerHTML = message;
                document.getElementById('alertContainer').appendChild(alertDiv);
                setTimeout(() => {
                    alertDiv.classList.remove('show');
                    setTimeout(() => alertDiv.remove(), 300);
                }, 2000);
            }
        }
    </script>
}