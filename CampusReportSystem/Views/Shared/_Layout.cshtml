@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Campus Report System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- APPLY THEME IMMEDIATELY TO PREVENT FLASH -->
    <script>
            if (localStorage.getItem('appTheme') === 'dark') {
                document.body.classList.add('dark-mode');
            }
    </script>

    <header class="sticky-top z-3">
        <nav class="navbar navbar-expand-sm p-0 mb-4 py-0 p-0">
            <div class="container-fluid flex-column align-items-stretch p-0">

                <div class="header-custom d-flex justify-content-between align-items-center w-100 px-3 py-2">
                    <a class="navbar-brand m-0" asp-area="" asp-controller="Home" asp-action="Index">📑 TARInsight</a>

                    <div class="d-flex align-items-center">
                        <div id="nav-auth-box">
                            @if (Context.Session.GetInt32("UserId") != null)
                            {
                                <span class="auth-username me-2">
                                    Hello, @Context.Session.GetString("UserName")
                                </span>
                                // Dropdown menu
                                <div class="dropdown d-inline-block" data-bs-auto-close="outside">
                                    <a href="#" role="button" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-list fs-3" style="cursor:pointer; color:#fff;"></i>
                                    </a>
                                    
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown" style="min-width: 240px;">
                                        <li><a class="dropdown-item" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Home</a></li>
                                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person"></i> My Profile</a></li>

                                        @if (Context.Session.GetString("UserRole") == "Admin")
                                        {
                                            <!-- Maintenance item with toggle -->
                                            <li id="maintenance-toggle" style="cursor:pointer;">
                                                <a class="dropdown-item" onclick="toggleMaintenanceSubmenu(event)">
                                                    <i class="bi bi-tools"></i> Maintenance
                                                    <i class="bi bi-chevron-down float-end" id="maintenance-arrow"></i>
                                                </a>
                                                <ul class="list-unstyled ps-4" id="maintenance-submenu" style="display:none;">
                                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-person-gear"></i> Admin Maintenance</a></li>
                                                    <li><a class="dropdown-item" asp-controller="Member" asp-action="Index"><i class="bi bi-people"></i> Member Maintenance</a></li>
                                                </ul>
                                            </li>
                                        }

                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item text-danger" style="border:none; background:transparent;">Logout</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <a class="auth-btn btn-outline-custom" asp-controller="Account" asp-action="Login">Login</a>
                                <a class="auth-btn btn-solid-custom" asp-controller="Account" asp-action="Register">Register</a>
                            }
                        </div>
                        <button class="navbar-toggler ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarModules" aria-controls="navbarModules"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                    </div>
                </div>

                <div class="custom-vibrant-navbar collapse navbar-collapse w-100 border-top px-3 py-1" id="navbarModules" style="border-color: rgba(255,255,255,0.2) !important;">
                    <ul class="navbar-nav me-auto">
                        @* Admin nav *@
                        @if (Context.Session.GetString("UserRole") == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Categories" asp-action="Index">
                                    <i class="bi bi-tags-fill"></i> Category Management
                                </a>
                            </li>

                            <!-- ANNOUNCEMENT MANAGEMENT FOR ADMIN -->
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Announcement" asp-action="Manage">
                                    <i class="bi bi-megaphone-fill"></i> Announcement Management
                                </a>
                            </li>
                            
                            <!-- FEEDBACK MANAGEMENT FOR ADMIN -->
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Feedback" asp-action="AdminIndex">
                                    <i class="bi bi-gear-fill"></i> Feedback Management
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Report" asp-action="Index"><i class="bi bi-pencil-square"></i> Report Management</a>
                        </li>

                        <!-- PUBLIC FEEDBACK FEED FOR ALL MEMBERS -->
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Feedback" asp-action="Index">
                                <i class="bi bi-chat-left-text-fill"></i> Community Feedback
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        <!-- DARK MODE TOGGLE BUTTON -->
                        <li class="nav-item me-2">
                            <button id="themeToggleBtn" class="theme-toggle-btn" onclick="toggleTheme()">
                                🌙 Dark Mode
                            </button>
                        </li>
                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            <div class="main-content-card">
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="mt-auto py-3 text-white footer-custom">
        <div class="container">
            <div class="row gy-2 align-items-center">

                <div class="col-md-4 text-center text-md-start">
                    <span class="fw-bold d-block text-light mb-1">🏠 About Us</span>
                    <p class="text-white small mb-0">
                        A smart campus facility maintenance & reporting platform for TAR UMT.
                    </p>
                </div>

                <div class="col-md-4 text-center">
                    <span class="fw-bold d-block text-light mb-1">📞 Contact Us</span>
                    <p class="text-white small mb-0">
                        📧 support@tarumt.edu.my<br>☎️ +60 3-4145 0123
                    </p>
                </div>

                <div class="col-md-4 text-center text-md-end">
                    <span class="fw-bold d-block text-light mb-1">&copy; 2026 CampusReportSystem</span>
                    <div class="small">
                        <a class="text-info text-decoration-none" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                    </div>
                </div>

            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- DARK MODE TOGGLE SCRIPT -->
    <script>
            document.addEventListener("DOMContentLoaded", function() {
                const btn = document.getElementById('themeToggleBtn');
                if (document.body.classList.contains('dark-mode')) {
                    if (btn) btn.innerHTML = '☀️ Light Mode';
                }
            });

            function toggleTheme() {
                const body = document.body;
                const btn = document.getElementById('themeToggleBtn');
                const isDark = body.classList.toggle('dark-mode');

                if (isDark) {
                    localStorage.setItem('appTheme', 'dark');
                    if (btn) btn.innerHTML = '☀️ Light Mode';
                } else {
                    localStorage.setItem('appTheme', 'light');
                    if (btn) btn.innerHTML = '🌙 Dark Mode';
                }
            }

            function toggleMaintenanceSubmenu(e) {
                e.preventDefault();        
                e.stopPropagation();        
                var submenu = document.getElementById('maintenance-submenu');
                var arrow = document.getElementById('maintenance-arrow');
                if (submenu.style.display === 'none' || submenu.style.display === '') {
                    submenu.style.display = 'block';
                    if (arrow) arrow.className = 'bi bi-chevron-up float-end';
                } else {
                    submenu.style.display = 'none';
                    if (arrow) arrow.className = 'bi bi-chevron-down float-end';
                }
            }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>