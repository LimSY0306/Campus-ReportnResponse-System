@model List<CampusReportSystem.Models.User>

@if (!Model.Any())
{
    <tr>
        <td colspan="7" class="text-center text-muted">
            No accounts found.
        </td>
    </tr>
}
else
{
    foreach (var item in Model)
    {
        <tr>
            <td>@item.FormattedId</td>
            <td>@item.Name</td>
            <td>@item.Email</td>
            <td>
                @if (item.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactive</span>
                }
            </td>
            <td>@item.Reports.Count</td>
            <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
            <td class="text-center">
                <div class="d-flex justify-content-center gap-1">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white" title="Details">
                        <i class="bi bi-info-circle"></i>
                    </a>
                    <button type="button" class="btn btn-sm @(item.IsActive ? "btn-secondary" : "btn-success")"
                            data-bs-toggle="modal"
                            data-bs-target="#toggleStatusModal"
                            data-id="@item.Id"
                            data-name="@item.Name"
                            data-status="@(item.IsActive ? "Deactivate" : "Activate")"
                            title="@(item.IsActive ? "Deactivate" : "Activate")">
                        @if (item.IsActive)
                        {
                            <i class="bi bi-lock-fill"></i>
                        }
                        else
                        {
                            <i class="bi bi-unlock-fill"></i>
                        }
                    </button>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Delete">
                        <i class="bi bi-trash3-fill"></i>
                    </a>
                </div>
            </td>
        </tr>
    }
}