@model CampusReportSystem.Models.User

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    <div class="card shadow-sm col-lg-8 mx-auto">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
            <h4 class="mb-0 fw-semibold">User Profile</h4>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light btn-sm fw-bold">
                Edit Profile
            </a>
        </div>
        <div class="card-body p-4">
            @* Success Alert Notification *@
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @* Profile Picture & Summary Header *@
            <div class="text-center mb-4">
                <img src="@(string.IsNullOrEmpty(Model.ProfilePicturePath) ? "https://via.placeholder.com/150?text=Profile" : Model.ProfilePicturePath)" 
                     class="rounded-circle img-thumbnail shadow-sm mb-2" 
                     style="width: 140px; height: 140px; object-fit: cover;" 
                     alt="Profile Picture" />
                <h5 class="fw-bold mb-1">@Model.Name</h5>
                <span class="badge bg-secondary">@Model.Role (@Model.FormattedId)</span>
            </div>

            <hr />

            @* Profile Details List *@
            <dl class="row mb-0 fs-6">
                <dt class="col-sm-4 text-muted">User ID</dt>
                <dd class="col-sm-8 fw-semibold">@Model.FormattedId</dd>

                <dt class="col-sm-4 text-muted">Full Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4 text-muted">Email Address</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4 text-muted">Phone Number</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</dd>

                <dt class="col-sm-4 text-muted">Gender</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Gender) ? "Not specified" : Model.Gender)</dd>

                <dt class="col-sm-4 text-muted">Date of Birth</dt>
                <dd class="col-sm-8">@(Model.BirthDate?.ToString("yyyy-MM-dd") ?? "Not specified")</dd>

                <dt class="col-sm-4 text-muted">Account Status</dt>
                <dd class="col-sm-8">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </dd>

                <dt class="col-sm-4 text-muted">Member Since</dt>
                <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd")</dd>
            </dl>
        </div>
    </div>
</div>