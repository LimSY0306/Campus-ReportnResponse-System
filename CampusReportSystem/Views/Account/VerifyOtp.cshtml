@{
    ViewData["Title"] = "Verify OTP";
}

<div class="container mt-4" style="max-width: 500px;">
    <h2>Email / Phone Verification</h2>
    <p class="text-muted">Enter the 6-digit OTP code sent to your phone (check VS Code console terminal during testing).</p>

    <form asp-controller="Account" asp-action="VerifyOtp" method="post" class="mt-3">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-group mb-3">
            <label class="form-label">6-Digit OTP Code</label>
            <input type="text" name="inputOtp" class="form-control" placeholder="e.g. 123456" maxlength="6" required />
        </div>

        <button type="submit" class="btn btn-primary w-100">Verify & Complete Registration</button>
    </form>
</div>