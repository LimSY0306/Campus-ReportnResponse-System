@{
    ViewData["Title"] = "Reset Password";
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <h3 class="card-title text-center mb-3 fw-bold text-primary">Reset Password</h3>
            <p class="text-muted text-center small mb-4">
                Please enter @ViewBag.Email new password.
            </p>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="@ViewBag.Email" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">New Password</label>
                    <input type="password" name="newPassword" class="form-control" placeholder="new password" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Confirm New Password</label>
                    <input type="password" name="confirmPassword" class="form-control" placeholder="confirm new password" required />
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-primary py-2 fw-semibold">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>