@model CampusReportSystem.Models.LoginViewModel

@{
    ViewData["Title"] = "User Login";
}

<div class="d-flex justify-content-center align-items-center my-5">
    <div class="card shadow-sm p-4 style-card" style="width: 100%; max-width: 480px; border-radius: 12px;">
        <h2 class="text-center mb-4 font-weight-bold">User Login</h2>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center mb-3">
                @TempData["SuccessMessage"]
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            
            <!-- 错误提示 + Forgot Password 按钮栏 -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="d-flex align-items-center justify-content-between mb-3 p-2 bg-light border border-danger rounded">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-0 small me-2"></div>
                    
                    @if (ViewBag.ShowForgotPassword == true)
                    {
                        <a asp-controller="Account" asp-action="ForgotPassword" class="btn btn-outline-danger btn-sm text-nowrap ms-auto">
                            Forgot Password?
                        </a>
                    }
                </div>
            }

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="Please enter your email" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password" class="form-label fw-semibold">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Please enter your password" required />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- 新增：Remember Me 勾選框 -->
            <div class="form-group form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" id="rememberMe" />
                <label class="form-check-label fw-semibold" for="rememberMe">
                    Remember Me
                </label>
            </div>

            <div class="d-flex gap-2 mb-3 mt-4">
                <button type="submit" class="btn btn-primary flex-grow-1">Login</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to Home</a>
            </div>

            <div class="text-center mt-3">
                <span class="text-muted">Don't have an account?</span>
                <a asp-controller="Account" asp-action="Register" class="text-decoration-none fw-bold ms-1">Register here</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}