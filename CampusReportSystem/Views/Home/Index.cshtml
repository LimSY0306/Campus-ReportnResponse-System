@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model IEnumerable<CampusReportSystem.Models.Report>

@{
    ViewData["Title"] = "Home Page";
    var userId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId");
    var userRole = Context.Session.GetString("UserRole");
    var submitController = userId != null ? "Feedback" : "Account";
    var submitAction = userId != null ? "Submit" : "Login";
    var historyAction = userId != null ? "History" : "Login";

    var filteredReports = Model?.Where(r => r.Category == null || r.Category.Name != "Announcement").ToList();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container py-4">
    <!-- Header Welcome Card -->
    <div class="row justify-content-center mb-4">
        <div class="col-12 col-md-10">
            <div class="home-content-card text-center py-5 shadow-sm rounded-4 bg-white">
                <h1 class="display-5 fw-bold text-dark mb-2">👋 Welcome to TARInsight</h1>
                <p class="text-muted mb-0 fs-6">
                    Your quick hub for reporting campus issues and tracking updates. <br>
                    Help us keep our campus safe, clean, and fully working for everyone!
                </p>
            </div>
        </div>
    </div>

    <!-- Main Navigation Cards (3 Columns Layout) -->
    <div class="row g-4 justify-content-center mb-5">
        <!-- 1. Create New Report -->
        <div class="col-md-6 col-lg-4">
            <a asp-controller="Report" asp-action="Create" class="home-content-card clickable-card h-100 text-center m-0 d-block text-decoration-none p-4 bg-white rounded-4 shadow-sm">
                <div class="d-flex flex-column h-100 justify-content-center">
                    <div class="fs-1 mb-2 text-primary"><i class="bi bi-pen"></i></div>
                    <h3 class="h4 fw-bold mb-2 text-dark">Create New Report</h3>
                    <p class="text-muted mb-0">
                        Found a broken facility? <br>
                        Pick a category and drop a pin to let us know.
                    </p>
                </div>
            </a>
        </div>

        <!-- 2. Announcement -->
        <div class="col-md-6 col-lg-4">
            <div class="home-content-card h-100 text-center m-0 d-flex flex-column justify-content-between p-4 bg-white rounded-4 shadow-sm">
                <div>
                    <div class="fs-1 mb-2 text-primary"><i class="bi bi-megaphone"></i></div>
                    <h3 class="h4 fw-bold mb-2 text-dark">Announcement</h3>
                    <p class="text-muted mb-0">
                        Stay updated with the latest news, <br>
                        maintenance notices, and campus alerts.
                    </p>
                </div>

                <div class="d-flex gap-2 justify-content-center mt-3 flex-wrap">
                    <a asp-controller="Announcement" asp-action="Index" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold text-decoration-none">
                        <i class="bi bi-eye me-1"></i> View Announcements
                    </a>
                    @if (userRole == "Admin")
                    {
                        <a asp-controller="Announcement" asp-action="Create" class="btn btn-primary rounded-pill px-3 py-2 fw-semibold text-decoration-none">
                            <i class="bi bi-plus-circle me-1"></i> Create Announcement
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- 3. Feedback -->
        <div class="col-md-6 col-lg-4">
            <div class="home-content-card h-100 text-center m-0 d-flex flex-column justify-content-between p-4 bg-white rounded-4 shadow-sm">
                <div>
                    <div class="fs-1 mb-2 text-primary"><i class="bi bi-chat-quote"></i></div>
                    <h3 class="h4 fw-bold mb-2 text-dark">Feedback</h3>
                    <p class="text-muted">
                        Facing any issues or have ideas to share? <br>
                        Submit your thoughts directly to us here.
                    </p>
                </div>

                <div class="d-flex gap-2 justify-content-center mt-3">
                    <a asp-controller="@submitController" asp-action="@submitAction" class="btn btn-primary rounded-pill px-3 py-2 fw-semibold text-decoration-none">
                        <i class="bi bi-plus-circle me-1"></i> Submit Feedback
                    </a>
                    <a asp-controller="@submitController" asp-action="@historyAction" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold text-decoration-none">
                        <i class="bi bi-clock-history me-1"></i> My Feedback
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (userRole == "Admin")
    {
        <div class="row g-4 justify-content-center mb-5">
            <div class="col-md-6 col-lg-4">
                <div class="home-content-card h-100 text-center m-0 d-flex flex-column justify-content-between p-4 bg-white rounded-4 shadow-sm">
                    <div>
                        <div class="fs-1 mb-2 text-primary"><i class="bi bi-tools"></i></div>
                        <h3 class="h4 fw-bold mb-2 text-dark">User Maintenance</h3>
                        <p class="text-muted">
                            Manage system users and roles.<br>
                            Choose an option below to proceed.
                        </p>
                    </div>

                    <div class="d-flex gap-2 justify-content-center mt-3">
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold text-decoration-none">
                            <i class="bi bi-person-gear me-1"></i> Admin
                        </a>
                        <a asp-controller="Member" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold text-decoration-none">
                            <i class="bi bi-people me-1"></i> Member
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (filteredReports != null && filteredReports.Any())
    {
        <h3 class="fw-bold text-dark mb-3"><i class="bi bi-journal-text me-2"></i>Recent Campus Reports</h3>
        <div class="row g-4">
            @foreach (var item in filteredReports)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card bg-dark text-white p-3 border-secondary rounded-4 shadow-sm h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary">@(item.Category?.Name ?? "Report")</span>
                            </div>

                            <h5 class="card-title fw-bold text-white mb-2">@item.Title</h5>
                            <p class="card-text text-light opacity-75 fs-6">@item.Description</p>
                        </div>

                        <div class="mt-3">
                            <hr class="border-secondary my-2" />
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted"><i class="bi bi-calendar-event me-1"></i>@item.CreatedAT.ToString("yyyy-MM-dd")</small>

                                <button class="btn btn-sm btn-outline-danger btn-like rounded-pill px-3" 
                                        id="like-btn-@item.Id" 
                                        onclick="toggleLike(this, @item.Id)">
                                    <i class="bi bi-heart-fill me-1"></i> Like 
                                    <span class="like-count badge bg-danger text-white ms-1" id="like-count-@item.Id">0</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function toggleLike(btn, reportId) {
            $.post('/Report/ToggleLike', { id: reportId }, function(response) {
                if (response.success) {
                    
                    $('#like-count-' + reportId).text(response.likeCount);

                    
                    if (response.isLiked) {
                        $(btn).removeClass('btn-outline-danger').addClass('btn-danger text-white');
                    } else {
                        $(btn).removeClass('btn-danger text-white').addClass('btn-outline-danger');
                    }
                } else {
                    alert(response.message || "Please login first to react.");
                }
            });
        }
    </script>
}